{
  "name": "diiwaan",
  "version": "1.0.0",
  "private": true,
  "description": "Diiwaan \u2014 multi-tenant queue management for Somali businesses. Firebase Auth + MongoDB, no framework, no build step.",
  "type": "module",
  "scripts": {
    "dev": "node server/src/index.js",
    "start": "node server/src/index.js",
    "seed": "node server/scripts/seed-development-data.js",
    "test:api": "node server/test/api.test.mjs",
    "test:qr": "node web/test/qr-selftest.mjs",
    "test:tenancy": "node server/test/tenancy.test.mjs",
    "test:concurrency": "node server/test/concurrency.test.mjs",
    "test:palette": "node server/test/palette.test.mjs",
    "test:shell": "node web/test/shell-precache.test.mjs",
    "test:matrix": "node server/test/matrix.test.mjs",
    "test:escalation": "node server/test/escalation.test.mjs",
    "test:transitions": "node server/test/transitions.test.mjs",
    "test:role-gate": "node server/test/role-gate.test.mjs",
    "test:status-input": "node server/test/status-input.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jose": "^5.9.0",
    "mongodb": "^6.9.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.0.0"
  },
  "homepage": "https://diiwaan-so.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/uncannystranger/diiwaan.so.git"
  },
  "keywords": [
    "queue-management",
    "multi-tenant",
    "saas",
    "firebase-auth",
    "mongodb",
    "qr-code",
    "somalia"
  ]
}
