# Copy to .env and fill in. Never commit .env.

# --- Supabase (authentication + branding storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-side only. Needed for logo uploads. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BRANDING_BUCKET=branding

# Set to true once Google is enabled as a provider in Supabase
# (Authentication -> Providers -> Google) and this app's URL is listed as a
# redirect URL there. The sign-in button only appears when this is true.
SUPABASE_GOOGLE_AUTH=false

# --- MongoDB ---
# Leave MONGODB_URI empty in development to run a local MongoDB automatically.
MONGODB_URI=
MONGODB_DATABASE=diiwaan

# Seals the session cookie. Rotating it signs everyone out.
SESSION_SECRET=generate-with-openssl-rand-base64-48

# --- Web Push (customer "it is your turn" notifications) ---
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@diiwaan.so

# --- App ---
NODE_ENV=development
PORT=4173
APP_URL=http://localhost:4173
# Comma-separated. Empty means "reflect the request origin" (fine for local dev).
CORS_ORIGINS=
UPLOAD_MAX_BYTES=5242880
# Public joins allowed per minute from one address (a waiting room shares one).
JOIN_RATE_LIMIT=20
# Where the development MongoDB keeps its files when MONGODB_URI is empty.
MONGODB_DATA_DIR=

# ---------------------------------------------------------------------------
# Running the API test suite (npm run test:api)
#
# It signs in as real Supabase users, so it needs three throwaway accounts on
# your own project and their shared password. There are no defaults: without
# these the suite refuses to run rather than trying someone else's accounts.
# ---------------------------------------------------------------------------
TEST_PASSWORD=
TEST_OWNER_A=
TEST_OWNER_B=
TEST_STAFF_A=
